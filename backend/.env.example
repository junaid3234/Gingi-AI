# Backend environment variables
# Copy this file to .env for local development

# Database (defaults to SQLite when unset)
DATABASE_URL=sqlite+aiosqlite:///./gingiai.db

# JWT — change this in production (min 32 chars)
JWT_SECRET=replace-with-a-random-32-char-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Clerk (optional)
CLERK_SECRET_KEY=sk_test_...

# CORS — set to your frontend URL in production
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# ML model path
MODEL_PATH=../ml-model/models/gingivitis_rf_model.joblib
