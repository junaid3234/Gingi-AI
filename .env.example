# ─────────────────────────────────────────────────────────────────────────────
# GingiAI — Environment Variables Reference
# ─────────────────────────────────────────────────────────────────────────────
# Local dev:  copy to backend/.env  and  frontend/.env.local
# Railway:    set each var in the service's Variables tab
# Vercel:     set each var in Project Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── BACKEND ──────────────────────────────────────────────────────────────────

# Database — Railway Postgres plugin sets this automatically as DATABASE_URL
# Local SQLite (default when unset):
DATABASE_URL=sqlite+aiosqlite:///./gingiai.db
# Production Postgres (Railway provides postgres:// — app converts automatically):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# JWT — MUST be changed in production (min 32 chars, random string)
JWT_SECRET=replace-with-a-random-32-char-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Clerk (optional — app works without auth when unset)
CLERK_SECRET_KEY=sk_test_...

# CORS — comma-separated list of allowed frontend origins
# Production: set to your actual Vercel/Railway frontend URL
CORS_ORIGINS=http://localhost:3000
# Example for production:
# CORS_ORIGINS=https://gingi-ai.vercel.app,https://your-frontend.up.railway.app

# ML model path (Docker sets this automatically via ENV in Dockerfile)
MODEL_PATH=../ml-model/models/gingivitis_rf_model.joblib

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# ── FRONTEND ─────────────────────────────────────────────────────────────────

# Backend API URL — NEXT_PUBLIC_* vars are baked into the JS bundle at build time
# Must be set BEFORE building (Railway: set in Variables, then redeploy)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production example:
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# Clerk (optional — auth UI is hidden when unset)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
