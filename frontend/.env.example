# Frontend environment variables
# Copy this file to .env.local for local development
#
# IMPORTANT: NEXT_PUBLIC_* vars are baked into the JS bundle at BUILD TIME.
# On Railway/Vercel you must set these in the dashboard Variables tab
# and trigger a redeploy after changing them.

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk (optional — auth UI is hidden when unset)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
